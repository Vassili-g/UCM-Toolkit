{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiche d’un composant dans un système",
  "description": "composants/<id>/<système>.json : ce qu’un système documente d’un composant, en paraphrase française datée. `tokens` n’existe que pour un système qui publie des tokens de composant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "composant",
    "systeme",
    "lu",
    "pages",
    "variantes",
    "tailles",
    "anatomie",
    "etats",
    "clavier",
    "regles",
    "redaction",
    "particularites"
  ],
  "properties": {
    "composant": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "systeme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "lu": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "variantes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tailles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "anatomie": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "etats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "clavier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redaction": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "particularites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variante",
          "etat",
          "role",
          "token"
        ],
        "properties": {
          "variante": {
            "type": "string",
            "minLength": 1
          },
          "etat": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "token": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
