{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Index des composants",
  "description": "composants/index.json : un composant par entrée, avec ses voisins et son nom dans chaque système. Une valeur null dit que le système n’a pas ce composant, une clé absente que cela n’est pas encore vérifié.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "nom",
      "definition",
      "voisins",
      "systemes"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "nom": {
        "type": "string",
        "minLength": 1
      },
      "definition": {
        "type": "string",
        "minLength": 1
      },
      "voisins": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        }
      },
      "systemes": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nom",
                "url"
              ],
              "properties": {
                "nom": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "motifs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    }
  }
}
