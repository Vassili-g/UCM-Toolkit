              "property": "borderColor",
              "value": "#3b82f6",
              "state": "default"
            },
            {
              "property": "borderWidth",
              "value": "1px",
              "state": "default"
            },
            {
              "property": "color",
              "value": "#3b82f6",
              "state": "default"
            }
          ],
          "hover": {
            "properties": [
              {
                "property": "backgroundColor",
                "value": "#dbeafe"
              }
            ]
          },
          "focus": {
            "properties": [
              {
                "property": "boxShadow",
                "value": "0 0 0 3px rgba(59, 130, 246, 0.5)"
              }
            ]
          }
        },
        "tokenMappings": {
          "backgroundColor": {
