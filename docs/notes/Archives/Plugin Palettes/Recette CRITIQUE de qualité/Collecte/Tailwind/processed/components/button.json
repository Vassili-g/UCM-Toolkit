{
  "name": "Button",
  "description": "Button components for actions with multiple variants.",
  "designSystem": "Tailwind CSS",
  "version": "v4.0.0",
  "source": {
    "file": "documentation",
    "url": "https://tailwindcss.com/docs"
  },
  "props": [
    {
      "name": "variant",
      "type": "'solid' | 'outline' | 'ghost' | 'soft'",
      "defaultValue": "'solid'"
    },
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'warning' | 'error'",
      "defaultValue": "'primary'"
    }
  ],
  "states": [
    "default",
    "hover",
    "active",
    "focus",
    "disabled"
  ],
  "variants": [
    {
      "name": "solid",
      "subVariants": {
        "primary": {
          "properties": [
            {
              "property": "backgroundColor",
              "value": "#3b82f6",
              "state": "default"
            },
            {
              "property": "color",
              "value": "#ffffff",
              "state": "default"
            },
            {
              "property": "borderWidth",
              "value": "0",
              "state": "default"
            }
          ],
          "hover": {
            "properties": [
              {
                "property": "backgroundColor",
                "value": "#2563eb"
              }
            ]
          },
          "focus": {
            "properties": [
              {
                "property": "boxShadow",
                "value": "0 0 0 3px rgba(59, 130, 246, 0.5)"
              }
            ]
          }
        },
        "tokenMappings": {
          "backgroundColor": {
            "default": "#3b82f6",
            "hover": "#2563eb"
          },
          "color": "#ffffff",
          "boxShadow": "focus-ring-blue"
        }
      },
      "notes": [
        "Solid primary uses blue-600 (#3b82f6) and blue-700 (#2563eb) for hover"
      ]
    },
    {
      "name": "outline",
      "subVariants": {
