  "tokenMappings": {
    "backgroundColor": {
      "solid": {
        "primary": {
          "default": "#3b82f6",
          "hover": "#2563eb"
        }
      },
      "outline": {
        "primary": {
          "default": "transparent",
          "hover": "#dbeafe"
        }
      },
      "soft": {
        "primary": {
          "default": "#dbeafe",
          "hover": "#bfdbfe"
        }
      },
      "ghost": {
