  "notes": [
    "Spectrum Badge supports 24 color variants (including semantic and primitive colors)",
    "Three fill styles: bold (solid background), subtle (light background), outline (border only)",
    "Text color is white for bold variants on dark backgrounds, black for light background colors (notice, orange, yellow, chartreuse, celery)",
    "Subtle and outline variants use gray-1000 for text color",
    "Outline variants use layer-2 as background with semantic color borders",
    "lightDark() function is used for responsive dark/light mode colors"
  ]
}
