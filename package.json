{
  "name": "ucm-toolkit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "npm run build --workspace @ucm-kit/core && npm run test --workspaces --if-present && node scripts/run-tests.cjs",
    "build": "npm run build --workspace @ucm-kit/core && npm run build --workspace ucm-exporter-plugin && npm run build --workspace ucm-palettes-plugin && npm run build --workspace ucm-architect-plugin",
    "schema": "npm run schema --workspace @ucm-kit/core",
    "pins": "node scripts/pins-servis.mjs",
    "cascade": "npm run build --workspace @ucm-kit/core && node --test packages/cli/tests/cascade/cascade.test.mjs",
    "start": "npm run build",
    "build:plugin": "node scripts/construire-plugin.mjs build",
    "galerie:plugin": "node scripts/construire-plugin.mjs galerie",
    "test:paquet": "node scripts/construire-plugin.mjs test",
    "vues": "node scripts/vues.mjs",
    "agents:lire": "node scripts/agents-contexte.mjs lire",
    "agents:domicile": "node scripts/agents-contexte.mjs domicile",
    "agents:diff": "node scripts/agents-contexte.mjs diff"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.5.3"
  }
}
