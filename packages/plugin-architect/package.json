{
  "name": "ucm-architect-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:code": "esbuild src/code.ts --bundle --outfile=dist/code.js --platform=browser --target=chrome80 --sourcemap",
    "build:ui:js": "esbuild src/ui/index.ts --bundle --outfile=dist/ui.js --format=iife --platform=browser --target=chrome80 --minify",
    "build:ui": "npm run build:ui:js && node scripts/build-ui.cjs",
    "build:manifest": "node scripts/build-manifest.cjs",
    "build": "npm run typecheck && npm run build:code && npm run build:ui && npm run build:manifest",
    "galerie": "npm run build:ui && node galerie/build-galerie.cjs",
    "galerie:captures": "node galerie/capturer.cjs",
    "test": "node scripts/run-tests.cjs"
  },
  "dependencies": { "@ucm-kit/core": "*", "ucm-plugin-socle": "*" },
  "devDependencies": { "@figma/plugin-typings": "^1.68.0", "esbuild": "^0.28.0" }
}
