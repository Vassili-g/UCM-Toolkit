{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false
  },
  // Seuls les sous-chemins format et emplois se compilent : les lecteurs sont
  // du JavaScript pur et se publient tels quels.
  "include": ["src/format/**/*", "src/emplois/**/*"]
}
