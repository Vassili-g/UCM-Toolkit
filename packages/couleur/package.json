{
  "name": "ucm-couleur",
  "version": "0.1.0",
  "private": true,
  "description": "Le moteur de couleur d'UCM Palettes : conversions, plafond de chroma, rampes, préréglage Tailwind et contraste, sans Figma ni DOM.",
  "type": "module",
